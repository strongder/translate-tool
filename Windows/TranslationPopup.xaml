<Window x:Class="TranslatorApp.Windows.TranslationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Translation"
        SizeToContent="WidthAndHeight"
        MinWidth="200"
        MaxWidth="500"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <DropShadowEffect x:Key="PopupShadow"
                          Color="#000000"
                          Opacity="0.18"
                          BlurRadius="16"
                          ShadowDepth="4"
                          Direction="270"/>
        <Style x:Key="PopupTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
    </Window.Resources>

    <Border Background="#F7F7F8"
            BorderBrush="#D1D5DB"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,10"
            Effect="{StaticResource PopupShadow}">

        <StackPanel>
            <!-- Header: biểu tượng và nút đóng -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌐" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Dịch thuật" FontSize="12" Foreground="#6B7280"
                               FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="CloseButton"
                        Content="✕"
                        Width="22" Height="22"
                        FontSize="11"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="#9CA3AF"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                    <Setter Property="Background" Value="#FEE2E2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Đường kẻ ngang -->
            <Rectangle Height="1" Fill="#E5E7EB" Margin="0,0,0,8"/>

            <!-- Nội dung dịch -->
            <TextBlock x:Name="TranslationText"
                       Style="{StaticResource PopupTextStyle}"
                       MaxWidth="472"
                       Text="Đang dịch..."/>
        </StackPanel>
    </Border>
</Window>
