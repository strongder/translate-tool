<!-- ScreenOverlay.xaml -->

<Window x:Class="TranslatorApp.Windows.ScreenOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#55000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Cursor="Cross">

    <Grid>

        <!-- Canvas overlay -->
        <Canvas x:Name="RootCanvas"
                Background="Transparent"
                MouseDown="Canvas_MouseDown"
                MouseMove="Canvas_MouseMove"
                MouseUp="Canvas_MouseUp">

            <!-- Rectangle vùng chọn -->
            <Rectangle x:Name="SelectionRect"
                       Stroke="#3B82F6"
                       StrokeThickness="2"
                       Fill="#223B82F6"
                       Visibility="Collapsed"/>
        </Canvas>

        <!-- Hint góc trái -->
        <Border x:Name="HintBorder"
                Background="#CC1F2937"
                CornerRadius="6"
                Padding="12,7"
                Margin="20"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

            <TextBlock Text="Kéo để chọn vùng cần dịch  •  ESC để hủy"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontSize="13"/>
        </Border>

    </Grid>
</Window>